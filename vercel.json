{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/scout/(.*)", "destination": "/scout.html" },
    { "source": "/live/(.*)", "destination": "/live.html" },
    { "source": "/v/(.*)", "destination": "/fanview.html" },
    { "source": "/p/(.*)", "destination": "/player.html" },
    { "source": "/t/(.*)", "destination": "/team.html" },
    { "source": "/c/(.*)", "destination": "/club.html" },
    { "source": "/volleyball-apps", "destination": "/volleyball-apps.html" },
    { "source": "/best-volleyball-scorekeeping-apps-2026", "destination": "/best-volleyball-scorekeeping-apps-2026.html" },
    { "source": "/best-volleyball-stat-tracking-apps-2026", "destination": "/best-volleyball-stat-tracking-apps-2026.html" },
    { "source": "/best-apps-for-volleyball-clubs", "destination": "/best-apps-for-volleyball-clubs.html" },
    { "source": "/best-apps-for-volleyball-parents", "destination": "/best-apps-for-volleyball-parents.html" },
    { "source": "/volleyball-app-comparison-study", "destination": "/volleyball-app-comparison-study.html" },
    { "source": "/vs/gamechanger", "destination": "/vs-gamechanger.html" },
    { "source": "/volleyball-scorekeeper", "destination": "/volleyball-scorekeeper.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/support", "destination": "/support.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/support.html", "destination": "/support", "permanent": true },
    { "source": "/download.html", "destination": "/download", "permanent": true },
    { "source": "/vs-gamechanger.html", "destination": "/vs/gamechanger", "permanent": true },
    { "source": "/volleyball-scorekeeper.html", "destination": "/volleyball-scorekeeper", "permanent": true },
    { "source": "/volleyball-apps.html", "destination": "/volleyball-apps", "permanent": true },
    { "source": "/best-volleyball-scorekeeping-apps-2026.html", "destination": "/best-volleyball-scorekeeping-apps-2026", "permanent": true },
    { "source": "/best-volleyball-stat-tracking-apps-2026.html", "destination": "/best-volleyball-stat-tracking-apps-2026", "permanent": true },
    { "source": "/best-apps-for-volleyball-clubs.html", "destination": "/best-apps-for-volleyball-clubs", "permanent": true },
    { "source": "/best-apps-for-volleyball-parents.html", "destination": "/best-apps-for-volleyball-parents", "permanent": true },
    { "source": "/volleyball-app-comparison-study.html", "destination": "/volleyball-app-comparison-study", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
